# Local development uses the in-memory H2 database by default.
# For the production profile, provide a JDBC URL, for example:
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
FRONTEND_URL=http://localhost:5173
PORT=8080

# Base64-encoded random key of at least 32 bytes. Never commit a real key.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=roms-api
# Required only when no active admin exists; use a password of at least 12 characters.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=